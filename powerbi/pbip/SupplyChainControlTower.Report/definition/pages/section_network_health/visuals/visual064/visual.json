{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "visual064",
  "position": {
    "x": 20,
    "y": 148,
    "z": 1000,
    "height": 216,
    "width": 620,
    "tabOrder": 1000
  },
  "visual": {
    "visualType": "lineChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "inventory_trend"
                    }
                  },
                  "Property": "week_label"
                }
              },
              "queryRef": "inventory_trend.week_label",
              "nativeQueryRef": "week_label"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "inventory_trend"
                    }
                  },
                  "Property": "lane"
                }
              },
              "queryRef": "inventory_trend.lane",
              "nativeQueryRef": "lane"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Gap Trend"
                }
              },
              "queryRef": "_Measures.Gap Trend",
              "nativeQueryRef": "Gap Trend"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'The shortfall is growing on the lanes that already take longest'"
                }
              }
            },
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Replenishment gap by planning lane, 13 weeks - total stock on hand moved barely 2% over the same period'"
                }
              }
            },
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "objects": {
      "categoryAxis": [
        {
          "properties": {
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "valueAxis": [
        {
          "properties": {
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
