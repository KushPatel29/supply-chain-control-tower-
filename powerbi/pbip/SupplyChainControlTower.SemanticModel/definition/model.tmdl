model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dim_product","dim_supplier","dim_warehouse","dim_customer","dim_lot","dim_date","fact_orders","fact_inventory","_Measures","DataPath","security_mapping"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table dim_product
ref table dim_supplier
ref table dim_warehouse
ref table dim_customer
ref table dim_lot
ref table dim_date
ref table fact_orders
ref table fact_inventory
ref table _Measures
ref table security_mapping
ref table 'Time Intelligence'

ref role 'Sales - BC Lower Mainland'
ref role 'Regional Manager'
ref role 'Field Ops'

ref table fact_sourcing

ref table country_exposure

ref table perfect_order

ref table perfect_order_failures

ref table inventory_position

ref table transfer_opportunities

ref table inventory_trend
