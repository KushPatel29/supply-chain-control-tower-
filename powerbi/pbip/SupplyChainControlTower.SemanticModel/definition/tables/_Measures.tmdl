table _Measures
	lineageTag: db375e73-e25e-406f-8216-fd51d6e5b14c

	measure 'Total Revenue' = SUM(fact_orders[revenue])
		formatString: \$#,0.00
		lineageTag: cdc7dc36-f84b-43e1-bf50-c2fd5ed62e7e

	measure 'Total COGS' = SUM(fact_orders[cogs])
		formatString: \$#,0.00
		lineageTag: 95414b3e-150f-4f30-89f2-37dca3a6e7eb

	measure 'Gross Margin $' = [Total Revenue] - [Total COGS]
		formatString: \$#,0.00
		lineageTag: 0617cc8b-ce78-457b-b223-e49e93dc135a

	measure 'Gross Margin %' = DIVIDE([Gross Margin $], [Total Revenue])
		formatString: 0.0%
		lineageTag: 2db9c8ef-9fc9-47f1-b7d2-61fbaa08549c

	measure 'Total Orders' = DISTINCTCOUNT(fact_orders[order_id])
		formatString: #,0
		lineageTag: 8ced94ac-212e-44f8-b0a7-8cbb7ecb07c8

	measure 'OTIF Orders' = CALCULATE([Total Orders], fact_orders[otif_flag] = 1)
		formatString: #,0
		lineageTag: c5b37c1a-dd44-436e-9b1b-d6c8f4cd8b2a

	measure 'OTIF %' = DIVIDE([OTIF Orders], [Total Orders])
		formatString: 0.0%
		lineageTag: a53b68bf-f36b-499b-8644-96f011af4956

	measure 'Avg Fill Rate' = AVERAGE(fact_orders[fill_rate])
		formatString: 0.0%
		lineageTag: 346db450-a6ff-4b05-880b-4cffc0b682fb

	measure 'Qty Ordered' = SUM(fact_orders[qty_ordered])
		formatString: #,0
		lineageTag: 20b82a58-3852-46ed-878a-1b4358dbe0bf

	measure 'Qty Shipped' = SUM(fact_orders[qty_shipped])
		formatString: #,0
		lineageTag: 3d8abc15-4365-4127-a1b8-38193f406fe3

	measure 'Total Inventory Value' = SUM(fact_inventory[inventory_value])
		formatString: \$#,0
		lineageTag: e58b47c8-f8db-4119-9136-fb635aa4e524

	measure 'Qty On Hand' = SUM(fact_inventory[qty_on_hand])
		formatString: #,0
		lineageTag: 810a246f-c76e-4836-9e00-19bb188aa3ef

	measure 'Critical Expiry Value' = CALCULATE([Total Inventory Value], fact_inventory[expiry_risk_flag] = "Critical")
		formatString: \$#,0
		lineageTag: e1d87e95-555b-4e81-bdf9-5a790a6180d5

	measure 'Warning Expiry Value' = CALCULATE([Total Inventory Value], fact_inventory[expiry_risk_flag] = "Warning")
		formatString: \$#,0
		lineageTag: 4a3c2171-f9e7-4ae0-b517-e83ff6980c25

	measure '% Inventory at Risk' = DIVIDE([Critical Expiry Value] + [Warning Expiry Value], [Total Inventory Value])
		formatString: 0.0%
		lineageTag: 6e0e49e2-e94e-4fb2-a21e-56849a3c7ef0

	measure 'Avg Inventory Value' = AVERAGEX(VALUES(dim_date[full_date]), [Total Inventory Value])
		formatString: \$#,0
		lineageTag: e310e1a1-ff53-43ca-89be-1d92a96f8d41

	measure 'Inventory Turns' =
			VAR vDaysInPeriod = DATEDIFF(MIN(dim_date[full_date]), MAX(dim_date[full_date]), DAY) + 1
			VAR vAnnualizationFactor = DIVIDE(365, vDaysInPeriod)
			RETURN
			    DIVIDE([Total COGS], [Avg Inventory Value]) * vAnnualizationFactor
		formatString: #,0.0
		lineageTag: d7cf622b-34f2-4f65-b6ba-cf208ed34814

	measure 'Days On Hand' = DIVIDE(365, [Inventory Turns])
		formatString: #,0.0
		lineageTag: e199e7e7-a415-4a89-b22c-0a34a0d799db

	measure 'OTIF Target' = 0.95
		formatString: 0.0%
		lineageTag: c3f85290-b443-4fad-9364-caf0ca46ce88

	/// The half of the KPI that was missing: otif against what?
	measure 'OTIF vs Target' = [OTIF %] - [OTIF Target]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Verdict
		lineageTag: 2f01e384-1828-5a85-b7f7-c49aaf747f42

	/// The model decides what 'bad' means, once, instead of every reader deciding for themselves in the meeting.
	measure 'OTIF Status' =
			VAR vActual = [OTIF %]
			VAR vTarget = [OTIF Target]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(vActual), "No data",
			        vActual >= vTarget, "On target",
			        vActual >= vTarget - 0.01, "Watch",
			        "Off target"
			    )
		displayFolder: Verdict
		lineageTag: 7adffe58-494b-5653-b4a4-b276d98c502c

	/// Bind to Conditional formatting -> Field value. The hex values are the Meridian Nocturne semantic colours, so report and theme cannot drift apart.
	measure 'OTIF Colour' =
			SWITCH(
			    [OTIF Status],
			    "On target", "#3DD68C",
			    "Watch", "#F5A524",
			    "No data", "#454A82",
			    "#FF5C7A"
			)
		displayFolder: Verdict
		lineageTag: 505d10a1-8d48-5158-9e58-14f002c358b0

	/// Reference line under the callout, shown as the card's subtitle.
	measure 'OTIF Reference' =
			VAR vGap = [OTIF vs Target]
			VAR vAbove = vGap >= 0
			RETURN
			    "Target " & FORMAT([OTIF Target], "0.0%") & "   "
			        & IF(vAbove, "▲", "▼") & " "
			        & FORMAT(ABS(vGap) * 100, "0.0") & " pts" & IF(vAbove, " over", " under")
		displayFolder: Verdict
		lineageTag: 59bb9e4d-ee97-5208-a1b8-e916f55a415a

	/// Blank unless a single month is in scope: DATEADD over a six-month range
	/// shifts the whole window, and that is not a prior month. dim_date is marked
	/// as a date table here, so DATEADD is available - the only one of the six models where that is true.
	measure 'Revenue PM' =
			IF(
			    HASONEVALUE(dim_date[year_month]),
			    CALCULATE([Total Revenue], DATEADD(dim_date[full_date], -1, MONTH))
			)
		formatString: \$#,0
		displayFolder: Comparison
		lineageTag: 610f3ee3-7f8d-5772-8b8a-0096d344fe5b

	/// Change against the prior month.
	measure 'Revenue MoM %' = DIVIDE([Total Revenue] - [Revenue PM], [Revenue PM])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Comparison
		lineageTag: f2fb44fa-05a9-5786-a7ae-7e2574796b9f

	/// Card subtitle for Total Revenue.
	measure 'Revenue Reference' =
			VAR vPrior = [Revenue PM]
			RETURN
			    IF(
			        ISBLANK(vPrior),
			        "All periods in scope",
			        "Prior month " & FORMAT(DIVIDE(vPrior, 1000000), "\$#,0.0") & "M" & "   "
			            & IF([Total Revenue] >= vPrior, "▲", "▼") & " "
			            & FORMAT(ABS([Revenue MoM %]), "0.0%")
			    )
		displayFolder: Verdict
		lineageTag: 4fbed6f7-f9b1-56ed-9185-e17da27911f5

	/// States the basis instead of leaving a bare percentage.
	measure 'Margin Reference' = "Gross margin " & FORMAT(DIVIDE([Gross Margin $], 1000000), "\$#,0.0") & "M" & " on " & FORMAT(DIVIDE([Total Revenue], 1000000), "\$#,0.0") & "M" & " revenue"
		displayFolder: Verdict
		lineageTag: ce64e158-01cf-57af-8c36-857aef0e208a

	/// Splits the risk number into the two tiers behind it.
	measure 'Inventory Risk Reference' = "Critical " & FORMAT([Critical Expiry Value], "\$#,0") & "   Warning " & FORMAT([Warning Expiry Value], "\$#,0")
		displayFolder: Verdict
		lineageTag: 482997dc-3ce2-53eb-a6a7-bf29f0c4a622

	/// Highlights the largest value on the axis and recedes the rest.
	/// The bare ALLSELECTED() is what makes this work inside a conditional
	/// format: it restores the VISUAL's filter context, so VALUES() is the
	/// axis rather than the single data point. Iterating the column alone
	/// leaves the point's own filter in place and every bar matches itself;
	/// iterating the table walks rows, which is not the axis unless the
	/// dimension happens to have one row per value.
	measure 'Category Margin Colour' =
			VAR vHere = [Gross Margin $]
			VAR vExtreme =
			    CALCULATE(
			        MAXX(VALUES(dim_product[category]), [Gross Margin $]),
			        ALLSELECTED()
			    )
			RETURN
			    IF(vHere = vExtreme, "#3DD68C", "#454A82")
		displayFolder: Verdict
		lineageTag: 692afb5f-d50b-5bf7-8bd1-bb44c5d704ed

	/// Any category under the 95% OTIF target reads red - region, channel or lane.
	measure 'OTIF Breach Colour' =
			IF(
			    [OTIF %] < [OTIF Target],
			    "#FF5C7A",
			    "#454A82"
			)
		displayFolder: Verdict
		lineageTag: 4383159a-dde5-524e-b967-c924daa93d0d

	/// A semantic mapping rather than a ranking: Critical is red because it is critical, not because it happens to be the largest bar.
	measure 'Expiry Risk Colour' =
			SWITCH(
			    SELECTEDVALUE(fact_inventory[expiry_risk_flag]),
			    "Critical", "#FF5C7A",
			    "Warning", "#F5A524",
			    "#3DD68C"
			)
		displayFolder: Verdict
		lineageTag: d253aa66-aa98-5831-a362-84d9d20e473d

	/// Deterministic narrative. Smart Narrative would write this too, but a measure can be unit tested and cannot drift.
	measure 'Control Tower Insight' =
			VAR vOtif = [OTIF %]
			VAR vGap = vOtif - [OTIF Target]
			VAR vWorstRegion =
			    MAXX(TOPN(1, VALUES(dim_warehouse[region]), [OTIF %], ASC), dim_warehouse[region])
			VAR vWorstOtif = CALCULATE([OTIF %], dim_warehouse[region] = vWorstRegion)
			RETURN
			    "OTIF " & FORMAT(vOtif, "0.0%") & " against a " & FORMAT([OTIF Target], "0.0%")
			        & " target — " & IF(vGap >= 0, "on target", FORMAT(ABS(vGap) * 100, "0.0") & " pts short")
			        & ". " & vWorstRegion & " is the weakest lane at " & FORMAT(vWorstOtif, "0.0%")
			        & ", and " & FORMAT([% Inventory at Risk], "0.0%") & " of inventory value sits in the expiry window."
		displayFolder: Verdict
		lineageTag: 0166a3cc-0c83-5c3b-9c28-73412f73c5f8

	/// Rows on the approved vendor list: one per SKU-supplier award.
	measure 'Approved Sources' = COUNTROWS(fact_sourcing)
		formatString: #,0
		lineageTag: 87882699-728c-5fde-acd3-d957b3a11e30
		displayFolder: Sourcing

	/// SKUs with at least one approved source.
	measure 'Sourced SKUs' = DISTINCTCOUNT(fact_sourcing[product_id])
		formatString: #,0
		lineageTag: 382d92e0-759c-50f2-b092-a76d93af5264
		displayFolder: Sourcing

	/// SKUs with exactly one approved supplier. The number a supply chain director is asked for first, because it is the one with no plan B.
	measure 'Single-Source SKUs' =
			COUNTROWS(
			    FILTER(
			        VALUES(fact_sourcing[product_id]),
			        CALCULATE(DISTINCTCOUNT(fact_sourcing[supplier_id])) = 1
			    )
			)
		formatString: #,0
		lineageTag: 008f6d29-c15d-51ce-a7ab-c5912fabf92a
		displayFolder: Sourcing

	/// Herfindahl index over award shares, averaged across SKUs. 10,000 is a single source; under 1,500 is a genuinely spread base.
	measure 'Award HHI' =
			AVERAGEX(
			    VALUES(fact_sourcing[product_id]),
			    CALCULATE(SUMX(fact_sourcing, fact_sourcing[allocation_share] ^ 2)) * 10000
			)
		formatString: #,0
		lineageTag: da694c1b-0bfb-59cc-abc1-556c53b5fea4
		displayFolder: Sourcing

	/// COGS awarded to the origins in scope.
	measure 'Exposed COGS' = SUM(country_exposure[Exposed COGS])
		formatString: \$#,0
		lineageTag: fad1031c-f036-5ec5-9549-af0bf1e0e0a5
		displayFolder: Sourcing

	/// SKUs left with no QUALIFIED alternate if the selected origin closes. An unqualified alternate needs a requalification programme first, so it does not count as cover.
	measure 'Stranded SKUs' = SUM(country_exposure[Stranded SKUs])
		formatString: #,0
		lineageTag: 6946f535-5e6b-5bae-8157-e302ad4e11e3
		displayFolder: Sourcing

	/// Share of COGS sitting with the single biggest origin.
	measure 'Largest Origin Share' = MAX(country_exposure[Share of COGS])
		formatString: 0.0%
		lineageTag: 16462c1c-2cfa-57db-bdcc-8c9f6bfdfe6a
		displayFolder: Sourcing

	/// Concentration across origins. Above 2,500 is concentrated by the competition-authority convention this borrows.
	measure 'Country HHI' = SUMX(ALL(country_exposure), country_exposure[Share of COGS] ^ 2) * 10000
		formatString: #,0
		lineageTag: 0dd234b4-7a1e-55b6-a397-21f3dfdaa3ea
		displayFolder: Sourcing

	/// Award-weighted contract lead time. Weighted, because a 40-day source holding 4% of a SKU is not a 40-day supply chain.
	measure 'Contract Lead Days' =
			DIVIDE(
			    SUMX(fact_sourcing, fact_sourcing[contract_lead_days] * fact_sourcing[allocation_share]),
			    SUMX(fact_sourcing, fact_sourcing[allocation_share])
			)
		formatString: #,0.0
		lineageTag: 1de0182b-4210-57d5-bcf8-ec7eaa5f4d5e
		displayFolder: Sourcing

	/// How long the surviving qualified alternates take to deliver, i.e. how long the gap lasts.
	measure 'Switch Lead Days' = AVERAGE(country_exposure[Switch lead (days)])
		formatString: #,0.0
		lineageTag: 18d21e8f-10d1-5893-a329-8406828c2f07
		displayFolder: Sourcing

	/// Reddens the origin carrying the most COGS.
	measure 'Country Exposure Colour' =
			VAR vHere = [Exposed COGS]
			VAR vExtreme =
			    CALCULATE(
			        MAXX(VALUES(country_exposure[Origin]), [Exposed COGS]),
			        ALLSELECTED()
			    )
			RETURN
			    IF(vHere = vExtreme, "#FF5C7A", "#454A82")
		lineageTag: f3381362-7543-5be3-a079-2ac342049a73
		displayFolder: Sourcing


	/// Card subtitle: a count of single-source SKUs needs its base.
	measure 'Single-Source Reference' = "of " & FORMAT([Sourced SKUs], "#,0") & " SKUs   " & FORMAT([Approved Sources], "#,0") & " approved awards"
		lineageTag: bc982568-8bf4-5aa0-86e0-5fb8156a1658
		displayFolder: Sourcing

	/// Card subtitle for country concentration.
	measure 'Concentration Reference' = "Award HHI " & FORMAT([Award HHI], "#,0") & "   over " & FORMAT(DISTINCTCOUNT(country_exposure[Origin]), "0") & " origins"
		lineageTag: b14aa173-ca23-5577-b137-8d15d7c4869c
		displayFolder: Sourcing

	/// Card subtitle for contract lead time.
	measure 'Lead Time Reference' = "Switching adds " & FORMAT([Switch Lead Days], "#,0.0") & " days"
		lineageTag: 3dae8d21-d59e-5ad6-9eaa-23c093d963c2
		displayFolder: Sourcing

	/// The sourcing headline as a deterministic sentence, so the page states its own conclusion rather than leaving it to be inferred.
	measure 'Sourcing Insight' =
			VAR vWorst =
			    TOPN(1, ALL(country_exposure), country_exposure[Exposed COGS], DESC)
			VAR vWorstCountry = MAXX(vWorst, country_exposure[Origin])
			VAR vWorstShare = MAXX(vWorst, country_exposure[Share of COGS])
			VAR vWorstStranded = MAXX(vWorst, country_exposure[Stranded SKUs])
			VAR vWorstSwitch = MAXX(vWorst, country_exposure[Switch lead (days)])
			RETURN
			    FORMAT([Single-Source SKUs], "#,0") & " of " & FORMAT([Sourced SKUs], "#,0")
			        & " SKUs have a single approved source. "
			        & vWorstCountry & " carries " & FORMAT(vWorstShare, "0.0%")
			        & " of COGS: if that lane closed, " & FORMAT(vWorstStranded, "#,0")
			        & " SKUs would have no qualified alternate and the rest would wait "
			        & FORMAT(vWorstSwitch, "#,0.0") & " days for the next source."
		lineageTag: 2b4f44ba-5db6-5882-9cc7-155977480966
		displayFolder: Sourcing

	/// The published OTIF, read from the same file the tests read.
	measure 'Perfect Order Rate' = CALCULATE(MAX(perfect_order[Rate]), perfect_order[Measure] = "OTIF")
		formatString: 0.0%
		lineageTag: 12c923dc-77e7-532a-bf01-622480687e5a
		displayFolder: Service

	/// The delivery half of OTIF.
	measure 'On Time Rate' = CALCULATE(MAX(perfect_order[Rate]), perfect_order[Measure] = "On time")
		formatString: 0.0%
		lineageTag: 222e6c7a-343b-587d-a119-a7eebebe3604
		displayFolder: Service

	/// The quantity half of OTIF, at the 95% fill tolerance.
	measure 'In Full Rate' = CALCULATE(MAX(perfect_order[Rate]), perfect_order[Measure] = "In full")
		formatString: 0.0%
		lineageTag: 9231e016-5429-5c72-a09c-9f9ab8556006
		displayFolder: Service

	/// Orders in the selected failure class.
	measure 'Failure Orders' = SUM(perfect_order_failures[Orders])
		formatString: #,0
		lineageTag: 1280b77c-d4e8-5c6c-9a6d-48e48d984244
		displayFolder: Service

	/// Reddens whichever failure mode is actually the biggest.
	measure 'Failure Colour' =
			VAR vHere = [Failure Orders]
			VAR vExtreme =
			    CALCULATE(
			        MAXX(VALUES(perfect_order_failures[Failure]), [Failure Orders]),
			        ALLSELECTED()
			    )
			RETURN
			    IF(vHere = vExtreme, "#FF5C7A", "#454A82")
		lineageTag: 92be4fa6-7e81-5b14-9f12-551112b39b33
		displayFolder: Service

	/// Value of stock physically in the network this week.
	measure 'Stock On Hand' = SUM(inventory_position[on_hand_value])
		formatString: \$#,0
		lineageTag: 3195537e-f305-5a45-a446-d7017bab8421
		displayFolder: Inventory

	/// Cost of closing every position back to its reorder point. Shortfalls are summed, never netted against surpluses elsewhere - a surplus of SKU A in Calgary does not fill a hole in SKU B in Halifax.
	measure 'Replenishment Gap' = SUM(inventory_position[gap_value])
		formatString: \$#,0
		lineageTag: efe586e3-b2a4-5ef5-8a4e-dc9e00233d37
		displayFolder: Inventory

	/// SKU x warehouse combinations in scope.
	measure 'Positions' = COUNTROWS(inventory_position)
		formatString: #,0
		lineageTag: 960987de-073b-535f-a414-3b5ac4e05659
		displayFolder: Inventory

	/// Positions whose on hand plus on order is under the reorder point.
	measure 'Below Reorder Point' = CALCULATE([Positions], inventory_position[gap_units] > 0)
		formatString: #,0
		lineageTag: b1636bfb-8107-5e8d-bffd-86dc93dad1c1
		displayFolder: Inventory

	/// Share of positions under policy.
	measure 'Below Reorder Share' = DIVIDE([Below Reorder Point], [Positions])
		formatString: 0.0%
		lineageTag: 09642085-ee58-5790-81c3-e3498bd96288
		displayFolder: Inventory

	/// Days of demand the stock on hand covers.
	measure 'Cover Days' = AVERAGE(inventory_position[cover_days])
		formatString: #,0.0
		lineageTag: 536e0991-145b-511d-bb0e-8ca1f01fc57c
		displayFolder: Inventory

	/// Replenishment lead time of the governing source.
	measure 'Lead Days' = AVERAGE(inventory_position[lead_days])
		formatString: #,0.0
		lineageTag: 0169c8fb-11c2-57b7-82f4-79b208be72cf
		displayFolder: Inventory

	/// Positions whose cover is shorter than their OWN lead time. 20 days of cover is comfortable on a 6-day lane and a stockout on a 40-day one, so the comparison has to be per position rather than to an average.
	measure 'Stockout Window' = CALCULATE([Positions], inventory_position[covers_lead_time] = 0)
		formatString: #,0
		lineageTag: 4d30abeb-6b53-5ad9-868c-709624ff847e
		displayFolder: Inventory

	/// Working capital sitting above 1.5x the reorder point. Reported alongside the shortfall rather than netted against it - they are different SKUs in different places.
	measure 'Excess Value' = SUM(inventory_position[excess_value])
		formatString: \$#,0
		lineageTag: 0513fc6f-ab98-5da6-b066-2a1862267273
		displayFolder: Inventory

	/// Part of the shortfall a stock transfer covers, needing no purchase order: short in one warehouse, long in another, same SKU.
	measure 'Transfer Value' = SUM(transfer_opportunities[transferable_value])
		formatString: \$#,0
		lineageTag: 35a9f03c-a098-5690-8390-bb36028a8ca4
		displayFolder: Inventory

	/// SKUs that are short somewhere and long somewhere else.
	measure 'Transfer SKUs' = COUNTROWS(transfer_opportunities)
		formatString: #,0
		lineageTag: 125460c1-3795-527e-a5dc-cadf9197721c
		displayFolder: Inventory

	/// How much of the whole gap is a move rather than a purchase.
	measure 'Transfer Share' = DIVIDE([Transfer Value], CALCULATE([Replenishment Gap], ALL(inventory_position)))
		formatString: 0.0%
		lineageTag: 642cb466-7e98-5f52-bd65-7cfd95efacd0
		displayFolder: Inventory

	/// The replenishment gap week by week.
	measure 'Gap Trend' = SUM(inventory_trend[gap_value])
		formatString: \$#,0
		lineageTag: 5dd13aed-d9fa-511f-a20b-67c755764747
		displayFolder: Inventory

	/// Stock on hand week by week.
	measure 'Stock Trend' = SUM(inventory_trend[on_hand_value])
		formatString: \$#,0
		lineageTag: 634ca9ef-b4b8-5c16-a434-fd54ba783182
		displayFolder: Inventory

	/// Change in the replenishment gap across the weeks in view. First and last week are read from the selection, so a filtered page reports the drift over what is on screen rather than a hard-coded quarter.
	measure 'Gap Drift' =
			VAR vWeeks = ALLSELECTED(inventory_trend[week_index])
			VAR vOpened =
			    CALCULATE([Gap Trend], inventory_trend[week_index] = MINX(vWeeks, inventory_trend[week_index]))
			VAR vClosed =
			    CALCULATE([Gap Trend], inventory_trend[week_index] = MAXX(vWeeks, inventory_trend[week_index]))
			RETURN
			    DIVIDE(vClosed - vOpened, vOpened)
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: f9997ca4-ef38-5a3e-b79e-68b7c9940dbc
		displayFolder: Inventory

	/// Change in stock on hand over the same weeks. The pair is the finding: a gap that grows while the total barely moves is a network rotating stock into the wrong lanes, not one running out of it.
	measure 'Stock Drift' =
			VAR vWeeks = ALLSELECTED(inventory_trend[week_index])
			VAR vOpened =
			    CALCULATE([Stock Trend], inventory_trend[week_index] = MINX(vWeeks, inventory_trend[week_index]))
			VAR vClosed =
			    CALCULATE([Stock Trend], inventory_trend[week_index] = MAXX(vWeeks, inventory_trend[week_index]))
			RETURN
			    DIVIDE(vClosed - vOpened, vOpened)
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 5dc49feb-7cb6-544f-bcea-fa22e19418cd
		displayFolder: Inventory

	/// Reddens the warehouse carrying the largest shortfall.
	measure 'Gap Colour' =
			VAR vHere = [Replenishment Gap]
			VAR vExtreme =
			    CALCULATE(
			        MAXX(VALUES(inventory_position[warehouse_name]), [Replenishment Gap]),
			        ALLSELECTED()
			    )
			RETURN
			    IF(vHere = vExtreme, "#FF5C7A", "#454A82")
		lineageTag: 99234783-737c-5363-818d-c20036b09321
		displayFolder: Inventory

	/// Greens the biggest transfer. Unlike the other highlights on this report the largest bar here is the good news, because it is the part of the shortfall that costs nothing to fix.
	measure 'Transfer Colour' =
			VAR vHere = [Transfer Value]
			VAR vExtreme =
			    CALCULATE(
			        MAXX(VALUES(transfer_opportunities[sku]), [Transfer Value]),
			        ALLSELECTED()
			    )
			RETURN
			    IF(vHere = vExtreme, "#3DD68C", "#454A82")
		lineageTag: 781e7929-2d61-5c1f-839c-f3f22fe21645
		displayFolder: Inventory

	/// Verdict on positions that cannot outlast their own lead time.
	measure 'Stockout Status' =
			VAR vShare = DIVIDE([Stockout Window], [Positions])
			RETURN
			    SWITCH(
			        TRUE(),
			        vShare <= 0.10, "On target",
			        vShare <= 0.25, "Watch",
			        "Off target"
			    )
		lineageTag: 57b7f19e-961b-5627-81e1-c0e18cb942e6
		displayFolder: Inventory

	/// Colour for the stockout-window verdict.
	measure 'Stockout Colour' =
			SWITCH(
			    [Stockout Status],
			    "On target", "#3DD68C",
			    "Watch", "#F5A524",
			    "#FF5C7A"
			)
		lineageTag: bca799a6-aed6-592e-be5f-414aa497a628
		displayFolder: Inventory

	/// Card subtitle: a shortfall in dollars needs its count.
	measure 'Gap Reference' = FORMAT([Below Reorder Point], "#,0") & " of " & FORMAT([Positions], "#,0") & " positions under policy"
		lineageTag: f9a930ff-d5e2-5429-91c1-07db1f4251d9
		displayFolder: Inventory

	/// Card subtitle pairing the gap drift with the stock drift.
	measure 'Drift Reference' = "stock on hand " & FORMAT([Stock Drift], "+0.0%;-0.0%;0.0%") & " over the same weeks"
		lineageTag: ba70f1a8-bbd6-561c-a7fc-6e17ccafc614
		displayFolder: Inventory

	/// Card subtitle for the stockout-window card.
	measure 'Stockout Reference' = FORMAT(DIVIDE([Stockout Window], [Positions]), "0.0%") & " of positions   " & [Stockout Status]
		lineageTag: 6ee56625-4094-5beb-89c9-5aa8055f583a
		displayFolder: Inventory

	/// Card subtitle for the transfer card.
	measure 'Transfer Reference' = FORMAT([Transfer SKUs], "#,0") & " SKUs   " & FORMAT([Transfer Share], "0.0%") & " of the gap"
		lineageTag: 66fba18b-e9f5-5665-b381-005db45cb750
		displayFolder: Inventory

	/// The inventory headline as a deterministic sentence, so the page states its own conclusion rather than leaving it to be inferred.
	measure 'Inventory Insight' =
			VAR vGap = CALCULATE([Replenishment Gap], ALL(inventory_position))
			VAR vShort = CALCULATE([Below Reorder Point], ALL(inventory_position))
			VAR vTotal = CALCULATE([Positions], ALL(inventory_position))
			VAR vWindow = CALCULATE([Stockout Window], ALL(inventory_position))
			VAR vMove = CALCULATE([Transfer Value], ALL(transfer_opportunities))
			VAR vWeeks = CALCULATE(DISTINCTCOUNT(inventory_trend[week_index]), ALL(inventory_trend))
			VAR vGapMove = CALCULATE([Gap Drift], ALL(inventory_trend))
			VAR vStockMove = CALCULATE([Stock Drift], ALL(inventory_trend))
			VAR vOffshore =
			    CALCULATE([Gap Drift], ALL(inventory_trend), inventory_trend[lane] = "Offshore")
			VAR vNearshore =
			    CALCULATE([Gap Drift], ALL(inventory_trend), inventory_trend[lane] = "Nearshore")
			RETURN
			    FORMAT(vShort, "#,0") & " of " & FORMAT(vTotal, "#,0")
			        & " positions are under their reorder point, " & FORMAT(vGap, "$#,0")
			        & " to close, and " & FORMAT(vWindow, "#,0")
			        & " of them cannot outlast their own lead time. Over "
			        & FORMAT(vWeeks, "0") & " weeks the gap moved "
			        & FORMAT(vGapMove, "+0.0%;-0.0%;0.0%") & " while stock on hand moved "
			        & FORMAT(vStockMove, "+0.0%;-0.0%;0.0%") & " - offshore lanes "
			        & FORMAT(vOffshore, "+0.0%;-0.0%;0.0%") & ", nearshore "
			        & FORMAT(vNearshore, "+0.0%;-0.0%;0.0%")
			        & ". The network is not running out of stock, it is holding it in the "
			        & "lanes that need it least. " & FORMAT(vMove, "$#,0")
			        & " of the gap is a transfer, not a purchase order."
		lineageTag: 88ce45a9-cddb-5f0a-aa39-7f5f81fcbb81
		displayFolder: Inventory

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5608e50b-58b0-4c92-b17b-c7eb8f62f3b6
		summarizeBy: none
		sourceColumn: Value

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Value = Int64.Type], {})
				in
				    Source

