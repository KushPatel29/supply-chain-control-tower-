// =====================================================================
// DAX measure library — Supply Chain Control Tower
// Organized as a "measure table" (create a blank table named _Measures
// in Power BI, hide it, and put all of these there — standard governed
// semantic-model practice instead of scattering measures across fact tables).
// =====================================================================

// ---------- Revenue / Margin ----------

Total Revenue = SUM(fact_orders[revenue])

Total COGS = SUM(fact_orders[cogs])

Gross Margin $ = [Total Revenue] - [Total COGS]

Gross Margin % =
DIVIDE([Gross Margin $], [Total Revenue])

// ---------- Fulfillment (OTIF) ----------

Total Orders = DISTINCTCOUNT(fact_orders[order_id])

OTIF Orders =
CALCULATE([Total Orders], fact_orders[otif_flag] = 1)

OTIF % =
DIVIDE([OTIF Orders], [Total Orders])

Avg Fill Rate =
AVERAGE(fact_orders[fill_rate])

Qty Ordered = SUM(fact_orders[qty_ordered])
Qty Shipped = SUM(fact_orders[qty_shipped])

// ---------- Inventory & Expiry Risk ----------

// Stock on hand as of the latest snapshot in the current filter context.
// fact_inventory holds one row per lot per WEEKLY snapshot, so a plain SUM adds
// 26 separate photographs of the same warehouse together: $34,564,500 against a
// real position of $202,393 - overstated 171x. Inventory is semi-additive: it
// adds across lots and warehouses, never across dates. The as-of date ignores
// the expiry-risk flag so Critical and Warning are shares of the same snapshot.
Total Inventory Value =
VAR vAsOfDate =
    CALCULATE(
        MAX(fact_inventory[date_key]),
        REMOVEFILTERS(fact_inventory[expiry_risk_flag])
    )
RETURN
    CALCULATE(
        SUM(fact_inventory[inventory_value]),
        fact_inventory[date_key] = vAsOfDate
    )

// The date those stock figures are as of.
Inventory As Of =
CALCULATE(MAX(dim_date[full_date]), fact_inventory[date_key] = CALCULATE(MAX(fact_inventory[date_key])))

// The as-of date as text, for the card subtitle on the inventory page.
Inventory As Of Label =
VAR vAsOf = [Inventory As Of]
RETURN
    IF(
        ISBLANK(vAsOf),
        "No stock in scope",
        "Stock as of " & FORMAT(vAsOf, "mmm d, yyyy")
    )

// Units on hand as of the latest snapshot, semi-additive for the same reason
// as Total Inventory Value: summing 26 snapshots reads 1,519,002 units
// against the latest snapshot's 8,735. That snapshot is a thin one -- see
// tests/test_inventory_is_semi_additive.py.
Qty On Hand =
VAR vAsOfDate =
    CALCULATE(
        MAX(fact_inventory[date_key]),
        REMOVEFILTERS(fact_inventory[expiry_risk_flag])
    )
RETURN
    CALCULATE(
        SUM(fact_inventory[qty_on_hand]),
        fact_inventory[date_key] = vAsOfDate
    )

Critical Expiry Value =
CALCULATE([Total Inventory Value], fact_inventory[expiry_risk_flag] = "Critical")

Warning Expiry Value =
CALCULATE([Total Inventory Value], fact_inventory[expiry_risk_flag] = "Warning")

% Inventory at Risk =
// "At risk" = anything flagged Critical or Warning by the FEFO calc in 02_silver_transform.py
DIVIDE([Critical Expiry Value] + [Warning Expiry Value], [Total Inventory Value])

// Average inventory value across the snapshot dates in the current filter context.
// Needed as the denominator for turns/days-on-hand — using a plain SUM would double-count
// across multiple weekly snapshots instead of averaging them.
Avg Inventory Value =
AVERAGEX(VALUES(dim_date[full_date]), [Total Inventory Value])

// Annualized inventory turns: how many times inventory is sold through per year.
// Standard formula = COGS / Average Inventory Value, scaled to the period in filter context.
Inventory Turns =
VAR DaysInPeriod = DATEDIFF(MIN(dim_date[full_date]), MAX(dim_date[full_date]), DAY) + 1
VAR AnnualizationFactor = DIVIDE(365, DaysInPeriod)
RETURN
    DIVIDE([Total COGS], [Avg Inventory Value]) * AnnualizationFactor

Days On Hand =
DIVIDE(365, [Inventory Turns])

// ---------- Row counts for QA / DQ dashboard tie-in ----------

DQ Checks Passed =
CALCULATE(COUNTROWS(dq_log), dq_log[passed] = TRUE)

DQ Checks Total = COUNTROWS(dq_log)

DQ Pass Rate = DIVIDE([DQ Checks Passed], [DQ Checks Total])
