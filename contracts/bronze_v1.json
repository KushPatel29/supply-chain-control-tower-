{
  "contract": "bronze-landing",
  "version": 1,
  "owner": "data-platform",
  "semantics": {
    "additive_change": "allowed (new columns are logged, never fatal)",
    "breaking_change": "fatal before Bronze (missing column, or type drift on a contracted column)"
  },
  "tables": {
    "dim_customer": {
      "customer_id": "integer",
      "customer_name": "string",
      "channel": "string",
      "region": "string"
    },
    "dim_lot": {
      "lot_id": "integer",
      "product_id": "integer",
      "supplier_id": "integer",
      "warehouse_id": "integer",
      "production_date": "string",
      "received_date": "string",
      "expiry_date": "string"
    },
    "dim_product": {
      "product_id": "integer",
      "sku": "string",
      "product_name": "string",
      "category": "string",
      "subcategory": "string",
      "shelf_life_days": "integer",
      "unit_of_measure": "string",
      "unit_cost": "number",
      "unit_price": "number"
    },
    "dim_supplier": {
      "supplier_id": "integer",
      "supplier_name": "string",
      "region": "string",
      "country": "string",
      "sourcing_bloc": "string",
      "supplier_tier": "string",
      "is_qualified_alternate": "integer"
    },
    "dim_warehouse": {
      "warehouse_id": "integer",
      "warehouse_name": "string",
      "region": "string",
      "city": "string"
    },
    "fact_inventory_snapshot": {
      "snapshot_date": "string",
      "lot_id": "integer",
      "product_id": "integer",
      "warehouse_id": "integer",
      "qty_on_hand": "number"
    },
    "fact_orders": {
      "order_id": "integer",
      "order_date": "string",
      "customer_id": "integer",
      "product_id": "integer",
      "lot_id": "integer",
      "warehouse_id": "integer",
      "qty_ordered": "integer",
      "qty_shipped": "number",
      "promised_date": "string",
      "shipped_date": "string",
      "unit_price": "number",
      "unit_cost": "number"
    },
    "fact_sourcing": {
      "product_id": "integer",
      "supplier_id": "integer",
      "allocation_share": "number",
      "contract_lead_days": "integer",
      "lead_time_sigma_days": "number",
      "moq_units": "integer",
      "price_index": "number",
      "is_primary": "integer"
    }
  }
}
